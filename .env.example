# Copie para .env e ajuste os valores.
# Em producao, os segredos JWT sao obrigatorios e devem ter pelo menos 32 caracteres.

NODE_ENV=development
PORT=3000

# Se vazio em desenvolvimento/teste, um MongoDB em memoria e iniciado automaticamente.
# Com o MongoDB local do workspace: mongodb://127.0.0.1:27018/autenticacao
# Em producao esta variavel e obrigatoria.
MONGODB_URI=

# Segredos diferentes para access e refresh nao sao necessarios aqui porque
# o access token e JWT e o refresh token e opaco (aleatorio + hash no banco).
# Gere um valor aleatorio, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Em desenvolvimento vazio usa um segredo local; em producao e obrigatorio.
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# Ajuste para a origem do seu frontend. Evite "*" fora do desenvolvimento local.
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20
